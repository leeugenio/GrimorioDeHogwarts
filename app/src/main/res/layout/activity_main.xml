<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/icone_menu"
            android:textSize="64sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingTop="12dp"
            android:text="@string/app_name"
            android:textColor="@color/roxo_hogwarts"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingTop="8dp"
            android:text="@string/subtitulo_menu"
            android:textColor="@color/cinza_texto"
            android:textSize="16sp" />

        <View
            android:layout_width="wrap_content"
            android:layout_height="40dp" />

        <Button
            android:id="@+id/btnPersonagem"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:onClick="abrirBuscaPersonagem"
            android:text="@string/btn_menu_personagem"
            android:textSize="17sp" />

        <View
            android:layout_width="wrap_content"
            android:layout_height="16dp" />

        <Button
            android:id="@+id/btnCriatura"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:onClick="abrirBuscaCriatura"
            android:text="@string/btn_menu_criatura"
            android:textSize="17sp" />

    </LinearLayout>

</ScrollView>
