<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F5FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🐉 Grimório de Hogwarts"
            android:textColor="#51216F"
            android:textSize="25sp"
            android:textStyle="bold"
            android:layout_marginTop="30dp"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Busca de Criaturas"
            android:textColor="#51216F"
            android:textSize="21sp"
            android:textStyle="bold"
            android:layout_marginBottom="25dp" />

        <EditText
            android:id="@+id/edtNomeCriatura"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Digite o nome da criatura"
            android:inputType="textCapSentences"
            android:padding="14dp"
            android:backgroundTint="#51216F" />

        <Button
            android:id="@+id/btnBuscarCriatura"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Buscar"
            android:layout_marginTop="16dp"
            android:backgroundTint="#51216F" />

        <ProgressBar
            android:id="@+id/progressCriatura"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/txtMensagemCriatura"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#B3261E"
            android:textSize="15sp"
            android:gravity="center"
            android:layout_marginTop="16dp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/layoutResultadoCriatura"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:padding="20dp"
            android:background="#FFFFFF"
            android:layout_marginTop="24dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/txtNomeCriatura"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#51216F"
                android:textSize="22sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginBottom="16dp" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="240dp">

                <ImageView
                    android:id="@+id/imgCriatura"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitCenter"
                    android:contentDescription="Imagem da criatura"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/txtImagemIndisponivel"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="🐉\nImagem indisponível"
                    android:textColor="#51216F"
                    android:textSize="20sp"
                    android:background="#EEE7F2"
                    android:visibility="gone" />

            </FrameLayout>

        </LinearLayout>

    </LinearLayout>

</ScrollView>
